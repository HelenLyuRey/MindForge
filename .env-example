# Copy this file to .env and fill in private values locally.
# Do not commit .env.

# Stage 1: DeepSeek export
DEEPSEEK_TOKEN=
# Vault root. Stage 3 writes chat notes into <this path>/chats/
OBSIDIAN_VAULT_PATH=

# Shared LLM provider switch:
# - kimi: paid Moonshot/Kimi API
# - ollama: local free Ollama
# - openai_compatible: custom OpenAI-compatible endpoint
LLM_PROVIDER=kimi

# Kimi / Moonshot
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6
# Keep true by default. Set false only for a trusted corporate proxy test,
# or prefer REQUESTS_CA_BUNDLE=/path/to/company-ca.pem.
KIMI_VERIFY_SSL=true

# Ollama fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Optional OpenAI-compatible provider
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Pipeline tuning
PIPELINE_BATCH_SIZE=10
PIPELINE_MAX_INPUT_CHARS=12000
PIPELINE_RETRIES=2
PIPELINE_REQUEST_TIMEOUT_SEC=300
LABEL_MAX_INPUT_CHARS=50000
LABEL_MAX_TAGS=5
LABEL_MAX_PURPOSES=2
